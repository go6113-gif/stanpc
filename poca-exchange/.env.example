# Copy this file to .env and fill in real values. Never commit .env.

# Prisma-compatible PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/stanpc?schema=public"

# --- Site ---------------------------------------------------------------
# Used for metadataBase/canonical/OG URLs. https://www.stanpc.com in prod.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Search console ownership verification -------------------------------
# Optional. Renders a <meta> tag in the root layout when set; omitted
# entirely if left blank. Prefixed NEXT_PUBLIC_ because it's read at
# render time and has no confidentiality requirement.
# Google Search Console -> Settings -> Ownership verification -> HTML tag
#   -> copy just the content="..." value (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# 네이버 서치어드바이저 -> 사이트 소유확인 -> HTML 태그 -> content 값만 복사.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""

# --- eBay Browse API (Production, Client Credentials Grant) --------------
# developer.ebay.com -> Application Keys -> Production. Server-only — used
# by lib/ebay.ts to fetch a cached app token, never exposed client-side.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# --- eBay EPN (Affiliate) Campaign ID -------------------------------------------
# eBay Partner Network (EPN) campaign ID for affiliate link tracking.
# Obtained from eBay Partner Network dashboard after joining the program.
# Used by lib/affiliate.ts to append tracking parameters to eBay URLs.
EBAY_EPN_CAMPAIGN_ID=""

# --- DK Shop Affiliate ID -------------------------------------------------------
# DK Shop affiliate program ID for commission tracking on Korean market.
# Obtained from DK Shop partnership dashboard.
# Used by lib/affiliate.ts for Korean photocard market integration.
DKSHOP_AFFILIATE_ID=""

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Required. Random secret used to encrypt session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Each provider only activates once BOTH its ID and SECRET are set — see
# docs/AUTH_SPEC.md for the MVP auth phase plan.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Authorized redirect URI: https://www.stanpc.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# X (Twitter) Developer Portal -> Project -> App -> Keys and tokens (OAuth 2.0)
#   Callback URL: https://www.stanpc.com/api/auth/callback/twitter
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# Kakao Developers -> 내 애플리케이션 -> 앱 키 (REST API 키 / Client Secret)
#   Redirect URI: https://www.stanpc.com/api/auth/callback/kakao
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# Naver Developers -> 애플리케이션 등록 -> Client ID / Client Secret
#   Callback URL: https://www.stanpc.com/api/auth/callback/naver
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# --- Supabase Auth -------------------------------------------------------
# Supabase project -> Settings -> API -> Project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Pricing & Referral System (Completely Configurable) ------------------
# All prices are in USD. Converted to local currencies by formatCurrency().
# Change these values to update pricing across the entire app instantly.
#
# Original price (USD) — defaults to 24
NEXT_PUBLIC_ORIGINAL_PRICE_USD=24

# Discount rate (0 = no discount, 0.3 = 30% off, etc.) — defaults to 0
NEXT_PUBLIC_DISCOUNT_RATE=0

# Referrer reward credits (how many credits the referrer gets) — defaults to 0
NEXT_PUBLIC_REFERRER_CREDITS=0

# Referee welcome credits (how many credits the new user gets) — defaults to 0
NEXT_PUBLIC_REFEREE_CREDITS=0

# Exchange rates (USD → local currency, for display only)
# Update these if exchange rates change or use a real-time API
NEXT_PUBLIC_EXCHANGE_RATE_KRW=1200
NEXT_PUBLIC_EXCHANGE_RATE_JPY=110
NEXT_PUBLIC_EXCHANGE_RATE_EUR=0.92
NEXT_PUBLIC_EXCHANGE_RATE_GBP=0.79

# Example configurations:
#
# Launch Special (30% off, $5 referrer reward, 500 credits to new user):
# NEXT_PUBLIC_ORIGINAL_PRICE_USD=24
# NEXT_PUBLIC_DISCOUNT_RATE=0.3
# NEXT_PUBLIC_REFERRER_CREDITS=5
# NEXT_PUBLIC_REFEREE_CREDITS=500
#
# Conservative Launch (no discounts, no credits yet):
# NEXT_PUBLIC_ORIGINAL_PRICE_USD=24
# NEXT_PUBLIC_DISCOUNT_RATE=0
# NEXT_PUBLIC_REFERRER_CREDITS=0
# NEXT_PUBLIC_REFEREE_CREDITS=0

# --- Cloudflare R2 (Image Storage) -----------------------------------------------
# R2 bucket credentials for storing resized photocard images.
# Obtained from Cloudflare Dashboard -> R2 -> API Token.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_ACCOUNT_ID=""
R2_BUCKET_NAME="stanpc-photocards"
R2_PUBLIC_DOMAIN="https://r2.stanpc.com"

# --- OpenAI Vision API (Photocard Classification) --------------------------------
# Used for gpt-4o-mini vision model to classify K-pop photocards.
# Obtained from platform.openai.com -> API keys.
OPENAI_API_KEY=""
