# Copy this file to .env and fill in real values. Never commit .env.

# Prisma-compatible PostgreSQL connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/stanpc?schema=public"

# --- Site ---------------------------------------------------------------
# Used for metadataBase/canonical/OG URLs. https://www.stanpc.com in prod.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Search console ownership verification -------------------------------
# Optional. Renders a <meta> tag in the root layout when set; omitted
# entirely if left blank. Prefixed NEXT_PUBLIC_ because it's read at
# render time and has no confidentiality requirement.
# Google Search Console -> Settings -> Ownership verification -> HTML tag
#   -> copy just the content="..." value (not the whole <meta> tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# 네이버 서치어드바이저 -> 사이트 소유확인 -> HTML 태그 -> content 값만 복사.
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=""

# --- eBay Browse API (Production, Client Credentials Grant) --------------
# developer.ebay.com -> Application Keys -> Production. Server-only — used
# by lib/ebay.ts to fetch a cached app token, never exposed client-side.
EBAY_CLIENT_ID=""
EBAY_CLIENT_SECRET=""

# --- eBay EPN (Affiliate) Campaign ID -------------------------------------------
# eBay Partner Network (EPN) campaign ID for affiliate link tracking.
# Obtained from eBay Partner Network dashboard after joining the program.
# Used by lib/affiliate.ts to append tracking parameters to eBay URLs.
EBAY_EPN_CAMPAIGN_ID=""

# --- DK Shop Affiliate ID -------------------------------------------------------
# DK Shop affiliate program ID for commission tracking on Korean market.
# Obtained from DK Shop partnership dashboard.
# Used by lib/affiliate.ts for Korean photocard market integration.
DKSHOP_AFFILIATE_ID=""

# --- Auth.js (NextAuth v5) --------------------------------------------------
# Required. Random secret used to encrypt session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Each provider only activates once BOTH its ID and SECRET are set — see
# docs/AUTH_SPEC.md for the MVP auth phase plan.
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
#   Authorized redirect URI: https://www.stanpc.com/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# X (Twitter) Developer Portal -> Project -> App -> Keys and tokens (OAuth 2.0)
#   Callback URL: https://www.stanpc.com/api/auth/callback/twitter
AUTH_TWITTER_ID=""
AUTH_TWITTER_SECRET=""

# Kakao Developers -> 내 애플리케이션 -> 앱 키 (REST API 키 / Client Secret)
#   Redirect URI: https://www.stanpc.com/api/auth/callback/kakao
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# Naver Developers -> 애플리케이션 등록 -> Client ID / Client Secret
#   Callback URL: https://www.stanpc.com/api/auth/callback/naver
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# --- Supabase Auth -------------------------------------------------------
# Supabase project -> Settings -> API -> Project URL and anon key
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
