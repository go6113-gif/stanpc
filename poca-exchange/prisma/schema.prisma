// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Prisma 7 generator. `output` is mandatory for the `prisma-client` provider —
// it no longer writes into node_modules. The path is fixed at
// app/generated/prisma so `@/app/generated/prisma/client` resolves through the
// existing tsconfig "@/*" alias; the directory is gitignored.
generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider  = "postgresql"
  
}

// -----------------------------------------------------------------------------
// User & Auth
// Source: docs/AUTH_SPEC.md — MVP social auth (NextAuth/Auth.js), KYC fields
// are reserved for Phase 2 (Stripe Identity / PASS) and stay nullable for now.
//
// Deviates from the AUTH_SPEC.md snippet in two ways, both required to wire
// up @auth/prisma-adapter's standard contract:
//  - `provider`/`providerAccountId` moved off User and onto Account, so a
//    user can link more than one OAuth provider instead of being pinned to
//    the one they first signed up with.
//  - `email` is nullable: Kakao only returns an email once the app passes
//    Kakao's business verification, so a required unique email would break
//    account creation for Kakao sign-ins until that's done.
// -----------------------------------------------------------------------------
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  name          String?
  image         String?

  isVerified      Boolean   @default(false)
  verifiedAt      DateTime?
  phoneNumber     String?
  countryCode     String? // KR, US, JP, etc.
  reputationScore Int       @default(100)

  // Collector Index ("덕력 포인트") — cached aggregate recomputed by
  // lib/collector-index.ts, never written by hand. Kept denormalised on User
  // because the leaderboard and profile header read it on every request and
  // recounting binder rows per view does not scale.
  //
  // `mannerScore` is the 당근마켓-style trust temperature: starts at body
  // temperature 36.5 and moves with trade conduct. It is deliberately separate
  // from `reputationScore` (0-100 abuse/report counter) — one measures how
  // pleasant a trade was, the other whether the account is in good standing.
  collectorIndex Int   @default(0) @map("collector_index")
  mannerScore    Float @default(36.5) @map("manner_score")

  // C2C 거래 연락 수단 — 공개 프로필에서 거래 문의 시 사용
  // 사용자가 직접 설정하는 선택사항. 공개 프로필 조회 시에만 노출
  twitterHandle String? @map("twitter_handle")
  openKakaoUrl  String? @map("open_kakao_url")
  discordUrl    String? @map("discord_url")

  // Stripe Billing — Collector/Pro tier subscription management
  tier                  String?   @default("FREE") // "FREE", "COLLECTOR", "PRO"
  stripeCustomerId      String?   @unique @map("stripe_customer_id")
  subscriptionId        String?   @unique @map("subscription_id")
  subscriptionStatus    String?   @map("subscription_status") // "active", "past_due", "canceled", etc.
  subscriptionExpiresAt DateTime? @map("subscription_expires_at")

  accounts Account[]
  sessions Session[]

  // Virtual binder: User → many BinderCards (through many-to-many)
  binderCards UserBinderCard[]

  // Smart Binder Rules: Custom filter conditions for binder views
  smartBinderRules SmartBinderRule[] @relation("SmartBinderRules")

  // Collector Index / gamification
  badges            UserBadge[]
  reactions         Reaction[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[] @relation("PushSubscriptions")

  // Proof Records for photocard ownership verification
  proofRecords ProofRecord[] @relation("ProofRecords")

  // Activity logs
  activityLogs ActivityLog[] @relation("ActivityLogs")

  // WTT (Want To Trade) — tables exist but stay unused in the MVP.
  bundleMatchesAsA  BundleMatch[] @relation("BundleMatchUserA")
  bundleMatchesAsB  BundleMatch[] @relation("BundleMatchUserB")
  tradeRoomsAsA     TradeRoom[]   @relation("TradeRoomUserA")
  tradeRoomsAsB     TradeRoom[]   @relation("TradeRoomUserB")
  tradeItemsOffered TradeItem[]   @relation("TradeItemOfferedBy")

  // Referral & Credits System — 글로벌 추천인 및 크레딧 관리
  referralCode        String?   @unique @map("referral_code") // 사용자의 고유 추천 코드
  referredBy          String?   @map("referred_by") // 나를 추천한 사용자의 referralCode
  credits             Int       @default(0) // 사용자의 누적 크레딧
  membershipType      String    @default("FREE") @map("membership_type") // "FREE", "COLLECTOR", "PRO"
  membershipExpiresAt DateTime? @map("membership_expires_at") // 멤버십 만료 일시

  // Referral logs
  referralLogs ReferralLog[]

  // Credit transactions
  creditTransactions CreditTransaction[] @relation("CreditTransactions")

  // Digital rewards
  digitalRewards UserDigitalReward[] @relation("DigitalRewards")

  // Referral code stats
  referralCodeStats ReferralCodeStats? @relation("ReferralCodeStats")

  // Contribution & Gamification (Module 2)
  xp                Int            @default(0) // Experience points from contributions
  contributorTier   String         @default("ROOKIE") @map("contributor_tier") // User gamification tier (ROOKIE/MEMBER/EXPERT/LEGEND)
  contributions     Contribution[] @relation("UserContributions")
  contributedPhotos PhotoCard[]    @relation("ContributedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

// Standard @auth/prisma-adapter shape: https://authjs.dev/reference/adapter/prisma
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // google, twitter, kakao
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// -----------------------------------------------------------------------------
// pSEO directory content
// Group -> Member -> PhotoCard, Group -> Album -> PhotoCard
// `slug` fields back the Dynamic Route structure:
//   /[group]                 -> Group.slug
//   /[group]/[member]        -> Member.slug (scoped to its group)
//   /card/[cardSlug]         -> PhotoCard.slug (globally unique)
// -----------------------------------------------------------------------------
model Group {
  id        String    @id @default(cuid())
  slug      String    @unique
  nameEn    String
  nameKr    String?
  aliases   String[]  @default([])
  agency    String?
  debutDate DateTime?
  imageUrl  String?

  members    Member[]
  albums     Album[]
  photoCards PhotoCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("groups")
}

// -----------------------------------------------------------------------------
// Artist — additive replacement for Group, in progress.
// Group cannot represent solo acts and stays live (22 files still query it) —
// see prisma/_migrate_schema.ts for why an in-place rename is unsafe on
// `db push`. Artist is a parallel table; Member/Album/PhotoCard gain a
// nullable artistId alongside their existing groupId so both read paths work
// during the transition. Group and the old *Id columns are dropped in a
// follow-up cutover once Artist data is verified.
// -----------------------------------------------------------------------------
enum ArtistType {
  GROUP
  SOLO

  @@map("artist_type")
}

model Artist {
  id        String     @id
  slug      String     @unique
  nameEn    String
  nameKr    String?
  aliases   String[]   @default([])
  agency    String?
  debutDate DateTime?
  imageUrl  String?
  type      ArtistType @default(GROUP)

  members    Member[]
  albums     Album[]
  photoCards PhotoCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("artists")
}

model Member {
  id       String  @id @default(cuid())
  slug     String
  nameEn   String
  nameKr   String?
  imageUrl String?
  position String?

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Additive mirror of groupId — see the Artist model comment above.
  artistId String? @map("artist_id")
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  photoCards PhotoCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([artistId])
  @@map("members")
}

model Album {
  id            String    @id @default(cuid())
  slug          String
  title         String
  coverImageUrl String?
  releaseDate   DateTime?

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Additive mirror of groupId — see the Artist model comment above.
  artistId String? @map("artist_id")
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  photoCards PhotoCard[]
  versions   Version[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([groupId, slug])
  @@index([groupId])
  @@index([artistId])
  @@map("albums")
}

// -----------------------------------------------------------------------------
// Version — one packaging/edition of an Album (e.g. "Weverse Ver.", "POB
// Ver."). Did not exist before this migration: album-version artwork was
// hotlinked straight from biasroomcdn.com with nowhere in the schema to
// record it. `sourceVersionId` is biasroom's own Version_ID, kept as the
// upsert key so re-running the fetch/import pipeline never duplicates rows.
// `imageUrl` only ever holds a local /images/album-versions/*.webp path —
// never the external CDN URL — populated from
// data/album_version_image_manifest.json for versions that downloaded
// successfully; left null otherwise rather than pointing at a broken path.
// -----------------------------------------------------------------------------
model Version {
  id              String    @id @default(cuid())
  slug            String
  versionName     String
  sourceVersionId String    @unique
  imageUrl        String?
  releaseDate     DateTime?

  albumId String
  album   Album  @relation(fields: [albumId], references: [id], onDelete: Cascade)

  photoCards PhotoCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([albumId, slug])
  @@index([albumId])
  @@map("versions")
}

model PhotoCard {
  id             String  @id @default(cuid())
  slug           String  @unique // pSEO URL slug used by /card/[cardSlug]
  cardName       String?
  version        String? // e.g. "Photobook Ver.", "Weverse MD", "POB" — freeform,
  // read by lib/queries.ts's gallery filter drawer (getGalleryFacets /
  // buildGalleryWhere). Kept even though every live row has it null today;
  // see `catalogVersion` below for the new structured relation instead.
  imageUrl       String? // Original_Image_URL
  thumbImagePath String? // Local_Thumb_Path (optimized WebP thumbnail)

  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Additive mirror of groupId — see the Artist model comment above.
  artistId String? @map("artist_id")
  artist   Artist? @relation(fields: [artistId], references: [id], onDelete: SetNull)

  memberId String?
  member   Member? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  albumId String?
  album   Album?  @relation(fields: [albumId], references: [id], onDelete: SetNull)

  // Structured counterpart to the freeform `version` string above — points at
  // the real Version catalog (prisma/_migrate_schema.ts Phase 3). Nullable:
  // Phase 4 attempts a best-effort match per existing PhotoCard and is
  // expected to succeed for very few of them, since cardName on today's live
  // rows carries no version identity to match against (see that script's
  // header comment). Named `catalogVersion`, not `version`, to avoid
  // colliding with the string field above.
  catalogVersionId String?  @map("catalog_version_id")
  catalogVersion   Version? @relation(fields: [catalogVersionId], references: [id], onDelete: SetNull)

  // Sprint 01 — pSEO directory MVP (no escrow/P2P): market signal fields
  // shown on the card tile/detail page. Est. price and badge are editorial
  // and stay null ("TBA") until priced; wish/owned/view counts are simple
  // aggregate counters, not per-user relations.
  // Terminology: wishedCount = users who want to acquire; ownedCount = users who own
  estimatedPrice Float?
  wishedCount    Int     @default(0) @map("wantCount")
  ownedCount     Int     @default(0) @map("haveCount")
  viewCount      Int     @default(0)
  badge          String?

  // Market price tracking (USD only). Single-currency baseline for global accessibility.
  // Updated by price-tracking pipeline or manual editorial input.
  priceUsd Float? @default(0) @map("price_usd") // US Dollar

  // pSEO/GEO 가이드 탭 본문 — Claude Sonnet이 생성한 위키 수준 마크다운 원문.
  // /card/[cardSlug]의 CardTabs가 RSC에서 이 문자열을 시맨틱 HTML로 파싱해
  // SSR로 내려보낸다. null이면 콘텐츠 준비 중 placeholder만 노출한다.
  guideContent String? @map("guide_content")

  // Outbound eBay/Buyee click tracking: clickCount is the quick aggregate
  // shown/used for sorting; outboundClicks is the per-event log (market +
  // timestamp) recorded by POST /api/tracking/outbound.
  clickCount     Int             @default(0)
  outboundClicks OutboundClick[]

  // User-submitted "시세 제보" (price tip) queue for TBA cards — editorial
  // review folds a report into `estimatedPrice` manually; submitting one
  // never writes `estimatedPrice` directly.
  priceReports PriceReport[]

  // Activity log references
  activityLogs ActivityLog[] @relation("ActivityLogs")

  // Time-series price history for trend analysis
  priceHistory PriceHistory[]

  // Multi-market SKU/URL mapping for cross-platform price comparison
  skuMappings GlobalSKUMapping[]

  // User virtual binder entries (collections, wishlists, etc.)
  userBinders UserBinderCard[]

  // WTT — cards put on the table inside a trade room. Inactive in the MVP.
  tradeItems TradeItem[]

  // Affiliate link routing: third-party marketplace URLs injected with
  // partner parameters (eBay/Buyee/DKShop). One per partner, allowing each
  // marketplace to get its own tracked link.
  affiliateLinks AffiliateLink[]

  // Contribution tracking (Module 2) — credited user who provided the image
  contributedById String?        @map("contributed_by_id")
  contributedBy   User?          @relation("ContributedBy", fields: [contributedById], references: [id], onDelete: SetNull)
  contributions   Contribution[] @relation("CardContributions")

  // --- 4-Tier Architecture (K-pop Photocard Taxonomy) ---
  // Layer 3: Source Type (Album/POB/Lucky Draw/Fansign/MD)
  sourceType String? @map("source_type") // "ALBUM", "POB", "LUCKY_DRAW", "FANSIGN", "MD", etc.

  // Layer 4: Detailed Attributes
  retailer    String?   // Seller/distributor (e.g., "YES24", "eBay")
  round       Int?      // POB round number or edition count
  material    String?   // Card material (e.g., "Hologram", "Matte", "Glossy")
  visualTags  String[]  @default([]) @map("visual_tags") // ["Standing", "Neon", "Holo", "Face-close"]
  phash       String?   // Perceptual hash for duplicate detection

  // --- SEO & UGC Indexing ---
  // Used by robots.txt/noindex to filter low-quality catalog data during crawl phase
  isIndexed   Boolean @default(true) @map("is_indexed") // Whether this card should appear in search/sitemap
  qualityScore Float  @default(0.0) @map("quality_score") // Editorial quality (0-10); feed selects 7+

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@index([artistId])
  @@index([memberId])
  @@index([albumId])
  @@index([catalogVersionId])
  @@index([sourceType, retailer]) // 4-Tier queries
  @@index([isIndexed]) // Crawler filtering
  @@index([createdAt])
  @@map("photo_cards")
}

// One row per outbound eBay/Buyee click. Anonymous by design — no user
// relation — since the site has no auth-gated buying flow yet.
model OutboundClick {
  id        String   @id @default(cuid())
  market    String // "ebay" | "buyee"
  createdAt DateTime @default(now())

  cardId String
  card   PhotoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([market])
  @@index([createdAt])
  @@map("outbound_clicks")
}

// -----------------------------------------------------------------------------
// Affiliate Link Router — Third-party marketplace partner URLs
// One row per card+partner combination: the affiliate link that forwards a
// user to (eBay / Buyee / DK Shop) with partner-specific parameters for
// commission tracking and revenue share.
//
// Separate from OutboundClick: OutboundClick is anonymous and raw (no partner
// affiliation); AffiliateLink is the parameterised router. A user can click
// either the native market link (OutboundClick) or a partner link (AffiliateLink).
// Both get logged independently.
// -----------------------------------------------------------------------------
model AffiliatePartner {
  id String @id @default(cuid())

  slug String @unique // "ebay", "buyee", "dk-shop", etc.
  name String // Display name: "eBay Affiliate", "Buyee Partner", etc.

  baseUrl String // Base URL for this partner (e.g., https://ebay.com, https://buyee.jp)

  // URL parameter template for injecting commission IDs. Null if not yet configured.
  // E.g. "?utm_source=stanpc&utm_medium=affiliate&aff_id=<PARTNER_ID>"
  paramTemplate String?

  // Partner-specific reference ID or app key for tracking.
  refId String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliateLinks AffiliateLink[]

  @@map("affiliate_partners")
}

model AffiliateLink {
  id String @id @default(cuid())

  cardId String
  card   PhotoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  partnerId String
  partner   AffiliatePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  // The full affiliate URL, pre-computed when the link is created. Cached here
  // so a redirect does not need to regenerate or interpolate it.
  affiliateUrl String

  createdAt DateTime @default(now())

  @@unique([cardId, partnerId])
  @@index([cardId])
  @@index([partnerId])
  @@map("affiliate_links")
}

// Anonymous user tip for a TBA card's real-world price. Reviewed manually —
// nothing here writes to PhotoCard.estimatedPrice automatically.
model PriceReport {
  id              String   @id @default(cuid())
  reportedPrice   Int
  sourceUrl       String?
  reporterComment String?

  // UGC Indexing — Price tips filtered for quality/spam
  isIndexed   Boolean @default(true) @map("is_indexed")
  qualityScore Float  @default(0.0) @map("quality_score")

  createdAt       DateTime @default(now())

  cardId String
  card   PhotoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@map("price_reports")
}

// -----------------------------------------------------------------------------
// Price History - Time series price tracking (for market trend analysis)
// Each entry records the estimated price snapshot at a point in time,
// sourced from eBay, Mercari, Buyee, etc. Used to compute price trends.
// -----------------------------------------------------------------------------
model PriceHistory {
  id        String   @id @default(cuid())
  price     Float // Stored price in primary currency (USD or KRW base)
  currency  String   @default("USD") // "USD", "KRW", "JPY", etc.
  market    String // "ebay", "mercari", "buyee", "banzai", "wts", etc.
  sourceUrl String? // Reference URL if scraped from market
  createdAt DateTime @default(now())

  cardId String
  card   PhotoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@index([cardId])
  @@index([market])
  @@index([createdAt])
  @@map("price_history")
}

// -----------------------------------------------------------------------------
// Global SKU Mapping - Multi-market product identifier linking
// One PhotoCard may have different SKUs/URLs across eBay, Mercari, Buyee, etc.
// Enables cross-market price comparison and direct outbound linking.
// -----------------------------------------------------------------------------
model GlobalSKUMapping {
  id          String    @id @default(cuid())
  market      String // "ebay", "mercari", "buyee", "banzai", "wts", etc.
  sku         String // Product ID in that market (eBay itemId, Mercari id, etc.)
  skuUrl      String? // Direct link to product on that market
  lastChecked DateTime? // Last time we verified this SKU still exists on market
  isActive    Boolean   @default(true) // Soft-delete for delisted items
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  cardId String
  card   PhotoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, market, sku])
  @@index([cardId])
  @@index([market])
  @@map("global_sku_mapping")
}

// Activity Log - 사용자 활동 기록 (활동 히트맵/잔디 생성용)
// 카드 추가, 거래 성사, 자랑 게시 등의 주요 활동을 시간 단위로 기록합니다.
// ProfileHeatmap에서 일자별 활동 횟수를 집계하는 데 사용됩니다.
// ---
enum ActivityType {
  CARD_ADDED      @map("CARD_ADDED") // 카드 소장 추가
  CARD_REMOVED    @map("CARD_REMOVED") // 카드 제거
  CARD_SHOWCASED  @map("CARD_SHOWCASED") // 자랑 게시
  TRADE_COMPLETED @map("TRADE_COMPLETED") // 거래 완료
  BADGE_EARNED    @map("BADGE_EARNED") // 뱃지 획득

  @@map("activity_type")
}

model ActivityLog {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation("ActivityLogs", fields: [userId], references: [id], onDelete: Cascade)

  type        ActivityType
  description String? // Optional: 활동 설명 (카드 이름, 거래 대상 등)

  // Optional reference to related card
  cardId String?    @map("card_id")
  card   PhotoCard? @relation("ActivityLogs", fields: [cardId], references: [id], onDelete: SetNull)

  // UGC Indexing — Activity logs filtered for public feed visibility
  isIndexed   Boolean @default(true) @map("is_indexed")
  qualityScore Float  @default(0.0) @map("quality_score")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([cardId])
  @@index([createdAt])
  @@index([type])
  @@map("activity_logs")
}

// 바인더 카드 상태 — 표준화된 수집 상태 분류
// 사용자가 카드에 대해 취하고 있는 행동/상태를 나타냄
enum UserBinderCardStatus {
  OWNED @map("OWNED") // 소유 중 (개인 수집용, 기본값)
  WTT   @map("WTT") // 교환 중 (Want To Trade)
  WTS   @map("WTS") // 판매 중 (Want To Sell)
  WTB   @map("WTB") // 구매 중 (Want To Buy, ISO와 동일)

  @@map("user_binder_card_status")
}

// Proof Record Status — Photocard ownership verification workflow
enum ProofStatus {
  PENDING // 심사 대기 중
  VERIFIED // 검증 완료
  REJECTED // 검증 실패

  @@map("proof_status")
}

// ---
// Tag — User-created custom tags for binder organization
// Normalized N:M table for scalability: enables tag search, auto-completion,
// and "popular tags" analytics for future P2P trading features.
// Each tag is globally shared (one tag per unique name across all users);
// UserBinderCardTag joins User collection entries to tags.
// ---
model Tag {
  id         String   @id @default(cuid())
  name       String   @unique // e.g., "#메이크스타", "#갈망포카"
  usageCount Int      @default(0) @map("usage_count") // Cached count of binder entries using this tag
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  binderCardTags UserBinderCardTag[]

  @@index([name])
  @@index([createdAt])
  @@map("tags")
}

// ---
// UserBinderCardTag — N:M join: User binder entries to custom tags
// Replaces the `customTags` String[] array on UserBinderCard for
// efficient filtering, aggregation, and autocomplete.
// ---
model UserBinderCardTag {
  id String @id @default(cuid())

  userBinderCardId String
  userBinderCard   UserBinderCard @relation(fields: [userBinderCardId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userBinderCardId, tagId])
  @@index([userBinderCardId])
  @@index([tagId])
  @@map("user_binder_card_tags")
}

// User Virtual Binder - Many-to-many relationship between User and PhotoCard
// with status tags: "In Hand", "ISO" (In Search Of), "#드볼중" (Seeking to buy),
// etc. Acts as a user collection/wishlist system.
// ---
// NOTE: `customTags` String[] is deprecated in favor of UserBinderCardTag N:M relation.
// Keep the array field for backward compatibility during migration; new UI uses tags relation.
// -----------------------------------------------------------------------------
model UserBinderCard {
  id         String               @id @default(cuid())
  tags       String[]             @default([]) // ["In Hand", "ISO", "#드볼중", "Trade Bait", etc.]
  customTags String[]             @default([]) // DEPRECATED: use binderCardTags relation instead
  note       String? // User's personal note about this card
  status     UserBinderCardStatus @default(OWNED) // 사용자 카드 상태 (OWNED/WTT/WTS/WTB)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String
  card   PhotoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // N:M relationship to custom tags (new normalized structure)
  binderCardTags UserBinderCardTag[]

  // A binder entry doubles as the "자랑" (show-off) unit other users react to.
  reactions Reaction[]

  // Proof record for this binder card ownership verification
  proofRecord ProofRecord?

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
  @@index([status])
  @@index([createdAt])
  @@map("user_binder_cards")
}

// ---
// Smart Binder Rule — Dynamic filter conditions for organizing binder views.
// Allows users to create custom filtration rules combining system filters
// (groups, members) and user-defined tags. Rules render as tabs in VaultPageClient
// and support different display modes (GRID, CHECKLIST, etc).
//
// **System filters**: Official catalog metadata (group/member slugs, album IDs).
// Stored as Json so new filter types can be added without schema changes.
// **Custom tags**: References to user-created tags via Tag.id array.
// Normalized for efficient join queries and "tag trending" analytics.
// ---
model SmartBinderRule {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("SmartBinderRules", fields: [userId], references: [id], onDelete: Cascade)

  name          String // 규칙 이름 (e.g., "2024 컬렉션", "현수막")
  systemFilters Json     @default("{}") // {"groups": ["aespa", "ive"], "members": ["karina"]}
  customTagIds  String[] @default([]) @map("custom_tag_ids") // Tag.id array for N:M filtering
  displayMode   String   @default("GRID") // "GRID", "CHECKLIST", etc.

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("smart_binder_rules")
}

// ---
// Proof Record — Photocard ownership verification via R2 image upload.
// Each proof is a single image tied to a UserBinderCard. The image is uploaded
// to R2 (Cloudflare), hashed for integrity verification, and stored in metadata.
// Verification status tracks editorial review (PENDING/VERIFIED/REJECTED).
// ---
model ProofRecord {
  id String @id @default(cuid())

  // Foreign key to the binder card this proof belongs to (1:1 relationship)
  userBinderCardId String         @unique @map("user_binder_card_id")
  userBinderCard   UserBinderCard @relation(fields: [userBinderCardId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation("ProofRecords", fields: [userId], references: [id], onDelete: Cascade)

  // R2 storage paths
  rawImageKey       String? @map("raw_image_key") // Original uploaded image key
  processedImageKey String? @map("processed_image_key") // Processed/optimized version

  // Image integrity: SHA-256 hash of the original file
  hashSha256 String? @map("hash_sha256")

  // Verification workflow
  status     ProofStatus @default(PENDING)
  verifiedAt DateTime?   @map("verified_at")

  // Metadata: EXIF, dimensions, etc.
  metadata Json? @db.JsonB

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userBinderCardId])
  @@index([status])
  @@index([createdAt])
  @@map("proof_records")
}

// -----------------------------------------------------------------------------
// Collector Index — Badges
// Badges are the visible half of the Collector Index: the index itself is a
// single number on User, badges are the milestones that number crosses.
//
// Badge is a seeded catalogue row rather than a hardcoded enum because the
// badge list is editorial (new ones ship with events/comebacks) and adding an
// enum value would mean a migration every time. UserBadge is the join.
//
// Field names are snake_case per the Stage-1 spec — see the note on
// User.collector_index for why this block departs from the camelCase above.
// -----------------------------------------------------------------------------
model Badge {
  badgeId     String  @id @default(cuid()) @map("badge_id")
  badgeName   String  @unique @map("badge_name") // stable key, e.g. "first_binder_complete"
  badgeIcon   String? @map("badge_icon") // emoji or asset path; null renders the default medal
  description String? // Korean UI copy shown in the badge tooltip

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String @map("badge_id")
  badge   Badge  @relation(fields: [badgeId], references: [badgeId], onDelete: Cascade)

  acquiredAt DateTime @default(now()) @map("acquired_at")

  // A badge is earned once. Re-awarding is a no-op upsert, not a second row.
  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

// -----------------------------------------------------------------------------
// Reactions — the 6 fixed emotion reactions
// The set and its order are frozen by CLAUDE.md. Identifiers are ASCII so the
// generated TypeScript stays i18n-friendly; `@map` pins the Korean label as the
// stored Postgres enum value so the DB representation matches the spec exactly.
// Display copy lives in lib/reactions.ts, keyed off this enum — no bare Korean
// string literals in components.
// -----------------------------------------------------------------------------
enum ReactionType {
  ENVY     @map("부럽다")
  LEGEND   @map("레전드")
  RADIANT  @map("영롱하다")
  INSANE   @map("미쳤다")
  RESPECT  @map("리스펙")
  WANT_TOO @map("나도갖고싶다")

  @@map("reaction_type")
}

// What a Reaction points at. Only VAULT_CARD is reachable in the MVP; POST is
// reserved so a future feed post can share this table instead of forcing a
// second reactions table and a data migration.
enum ReactionTargetType {
  VAULT_CARD
  POST

  @@map("reaction_target_type")
}

model Reaction {
  id   String       @id @default(cuid())
  type ReactionType

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  targetType ReactionTargetType @default(VAULT_CARD) @map("target_type")

  // Nullable FK rather than a generic (target_type, target_id) pair: the one
  // target that exists today gets real referential integrity and cascade
  // deletes, and the POST column can be added next to it later.
  vaultCardId String?         @map("vault_card_id")
  vaultCard   UserBinderCard? @relation(fields: [vaultCardId], references: [id], onDelete: Cascade)

  // UGC Indexing — Low-quality/spam reactions filtered by crawler
  isIndexed   Boolean @default(true) @map("is_indexed")
  qualityScore Float  @default(0.0) @map("quality_score")

  createdAt DateTime @default(now()) @map("created_at")

  // "유저별 중복 리액션 방지" — one row per (user, target, emotion). A user may
  // still leave two different emotions on the same card; tighten this to
  // [userId, vaultCardId] if the feed should allow only one.
  @@unique([userId, vaultCardId, type])
  @@index([vaultCardId])
  @@index([userId])
  @@index([type])
  @@map("reactions")
}

// -----------------------------------------------------------------------------
// Notifications
// Only the three MVP triggers exist as enum values. `payload` carries the
// type-specific ids (card slug, room id, reaction counts) as JSONB so adding a
// notification type does not mean adding columns; `title`/`body` are rendered
// Korean copy so a delivered notification never changes wording retroactively.
// -----------------------------------------------------------------------------
enum NotificationType {
  HOF_EXPOSURE // 명예의 전당 노출
  DAILY_REACTION_SUMMARY // 하루치 리액션 요약
  TRADE_MATCH // WTT 번들 매칭 성사 (inactive in MVP)
  CONTRIBUTION_APPROVED // 도감 이미지 채택 및 XP 지급
  PRICE_MATCH_ALERT // 원하는 가격대 카드 등장
  TRADE_OFFER // 교환 제안 도착

  @@map("notification_type")
}

model Notification {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String?

  payload Json? @db.JsonB

  isRead Boolean   @default(false) @map("is_read")
  readAt DateTime? @map("read_at")

  // UGC Indexing — Private notifications stay internal (not indexed)
  isIndexed Boolean @default(false) @map("is_indexed")

  createdAt DateTime @default(now()) @map("created_at")

  // Backs the unread badge and the reverse-chronological notification list.
  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
  @@map("notifications")
}

// PushSubscription — Web Push API subscriptions for browser notifications
model PushSubscription {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation("PushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  endpoint String // Browser push service endpoint
  p256dh   String // ECDH public key for encryption
  auth     String // Authentication secret

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint])
  @@index([userId])
  @@map("push_subscriptions")
}

// Contribution — User-submitted photocard images for catalog improvement
model Contribution {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation("UserContributions", fields: [userId], references: [id], onDelete: Cascade)

  photoCardId String    @map("photo_card_id")
  photoCard   PhotoCard @relation("CardContributions", fields: [photoCardId], references: [id], onDelete: Cascade)

  imageUrl String @map("image_url")
  status   String @default("PENDING") // PENDING / APPROVED / REJECTED
  rewardXp Int    @default(0) @map("reward_xp") // XP awarded upon approval

  // UGC Indexing — Only approved contributions are indexed
  isIndexed   Boolean @default(false) @map("is_indexed")
  qualityScore Float  @default(0.0) @map("quality_score")

  createdAt  DateTime  @default(now()) @map("created_at")
  approvedAt DateTime? @map("approved_at")

  @@index([userId, status])
  @@index([photoCardId, status])
  @@map("contributions")
}

// -----------------------------------------------------------------------------
// WTT (Want To Trade) — PRE-CREATED, DISABLED IN THE MVP
// Per CLAUDE.md these three tables ship with the migration but get no UI and no
// API route. They exist now so the P1 Vault and P2 Wiki work can be written
// against their final shape instead of being retrofitted later.
//
// Matching rule the tables are shaped for: a pair only becomes a BundleMatch
// when BOTH users hold at least 3 cards (MIN_BUNDLE_MATCH_CARDS in
// lib/wtt-scope.ts) the other side has flagged as wanted — bundling amortises
// the shipping cost that 40.9% of the surveyed posts complain about.
// -----------------------------------------------------------------------------
enum BundleMatchStatus {
  PENDING // computed, not yet surfaced to either user
  ROOM_OPENED // a TradeRoom was created from this match
  DISMISSED // one side declined
  EXPIRED // stale — one side has moved on

  @@map("bundle_match_status")
}

enum TradeRoomStatus {
  OPEN
  AGREED
  SHIPPED
  COMPLETED
  CANCELLED

  @@map("trade_room_status")
}

model BundleMatch {
  id String @id @default(cuid())

  // Pair is stored ordered (userAId < userBId) by the matcher so the unique
  // constraint below cannot be defeated by swapping the two sides.
  userAId String @map("user_a_id")
  userA   User   @relation("BundleMatchUserA", fields: [userAId], references: [id], onDelete: Cascade)

  userBId String @map("user_b_id")
  userB   User   @relation("BundleMatchUserB", fields: [userBId], references: [id], onDelete: Cascade)

  // Cards each side can hand over. Both must be >= MIN_BUNDLE_MATCH_CARDS.
  aToBCount Int @map("a_to_b_count")
  bToACount Int @map("b_to_a_count")

  // Ranking hint for the match list — recomputed, never user-editable.
  matchScore Float @default(0) @map("match_score")

  status BundleMatchStatus @default(PENDING)

  tradeRooms TradeRoom[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userAId, userBId])
  @@index([userBId])
  @@index([status])
  @@map("bundle_matches")
}

model TradeRoom {
  id String @id @default(cuid())

  // SetNull, not Cascade: a room outlives the recomputed match that spawned it.
  bundleMatchId String?      @map("bundle_match_id")
  bundleMatch   BundleMatch? @relation(fields: [bundleMatchId], references: [id], onDelete: SetNull)

  userAId String @map("user_a_id")
  userA   User   @relation("TradeRoomUserA", fields: [userAId], references: [id], onDelete: Cascade)

  userBId String @map("user_b_id")
  userB   User   @relation("TradeRoomUserB", fields: [userBId], references: [id], onDelete: Cascade)

  status TradeRoomStatus @default(OPEN)

  items TradeItem[]

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")

  @@index([userAId])
  @@index([userBId])
  @@index([bundleMatchId])
  @@index([status])
  @@map("trade_rooms")
}

model TradeItem {
  id String @id @default(cuid())

  tradeRoomId String    @map("trade_room_id")
  tradeRoom   TradeRoom @relation(fields: [tradeRoomId], references: [id], onDelete: Cascade)

  cardId String    @map("card_id")
  card   PhotoCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Which side is giving this card away.
  offeredByUserId String @map("offered_by_user_id")
  offeredBy       User   @relation("TradeItemOfferedBy", fields: [offeredByUserId], references: [id], onDelete: Cascade)

  // "상단 고정 교환 포카 목록" — the room header pins an ordered strip of the
  // bundle so both sides always see what is on the table without scrolling the
  // chat. `position` orders the pinned strip; unpinned items fall back to
  // createdAt.
  isPinned Boolean @default(false) @map("is_pinned")
  position Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  // The same card can appear once per side (both users owning a duplicate of
  // the same card is normal), but not twice from the same side.
  @@unique([tradeRoomId, cardId, offeredByUserId])
  @@index([tradeRoomId])
  @@index([cardId])
  @@index([offeredByUserId])
  @@map("trade_items")
}

// -----------------------------------------------------------------------------
// Waitlist — Fake Door demand validation
// No Pro plan or payment module exists yet (see docs/PHASE2_ROADMAP.md). The
// landing page's "Pro 업그레이드"/AI 스캔/멀티 바인더 CTAs open a modal
// instead of a paywall and collect an email here so we can measure real
// demand before building the paid feature. `source` records which CTA fired
// the modal for later breakdown; anonymous by design (no User relation) since
// this must also work for guests who haven't signed in.
// -----------------------------------------------------------------------------
model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String
  source    String // e.g. "pro_upgrade_header", "ai_scan", "multi_binder"
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([email, source])
  @@index([createdAt])
  @@map("waitlist_signups")
}

// -----------------------------------------------------------------------------
// Referral & Credits — 글로벌 추천인 및 크레딧 시스템
//
// 추천인-피추천인 관계, 크레딧 지급 기록을 추적합니다.
// 모든 금액과 리워드는 USD 기준이며, pricing.config.ts에서 관리됩니다.
// -----------------------------------------------------------------------------
model ReferralLog {
  id           String @id @default(cuid())
  referrerId   String @map("referrer_id") // 추천인 User ID
  referrer     User   @relation(fields: [referrerId], references: [id], onDelete: Cascade)
  refereeEmail String @map("referee_email") // 피추천인 이메일 (가입 전)

  // 링크 관계 (피추천인이 가입한 후 설정)
  refereeId String? @map("referee_id")

  // 크레딧 트랜잭션 기록
  referrerCreditsAwarded Int    @default(0) @map("referrer_credits_awarded") // 추천인에게 주어진 크레딧
  refereeCreditsAwarded  Int    @default(0) @map("referee_credits_awarded") // 피추천인에게 주어진 크레딧
  referrerCreditsStatus  String @default("PENDING") @map("referrer_credits_status") // "PENDING", "AWARDED", "REVOKED"
  refereeCreditsStatus   String @default("PENDING") @map("referee_credits_status")

  // 결제 연동
  paymentId     String? @map("payment_id") // Stripe payment ID (향후)
  paymentAmount Float?  @map("payment_amount") // 결제 금액 (USD)

  // Credit transaction link
  creditTransactions CreditTransaction[]

  // 타임스탐프
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([referrerId])
  @@index([refereeEmail])
  @@index([refereeId])
  @@map("referral_logs")
}

// ---
// Credit Transaction — 크레딧 거래 로그 (지급/소비)
// 각 크레딧의 출처와 용도, 시간을 추적합니다.
// 지급: 추천 완료, 신규 가입 보너스
// 소비: 년간 갱신비, 디지털 특전 구입
// ---
enum CreditTransactionType {
  REFERRAL_AWARDED      @map("REFERRAL_AWARDED") // 친구 추천 시 지급
  WELCOME_BONUS         @map("WELCOME_BONUS") // 신규 가입 웰컴 보너스
  ANNUAL_RENEWAL_DEDUCT @map("ANNUAL_RENEWAL_DEDUCT") // 년간 갱신비 차감
  REWARD_REDEEMED       @map("REWARD_REDEEMED") // 디지털 특전 구입 시 차감
  REVOKED               @map("REVOKED") // 환불 시 회수

  @@map("credit_transaction_type")
}

model CreditTransaction {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation("CreditTransactions", fields: [userId], references: [id], onDelete: Cascade)

  type        CreditTransactionType
  amount      Int // 양수: 지급, 음수: 소비
  description String? // "친구 'username' 추천", "년간 갱신비", etc.

  // 트랜잭션 링크 (선택사항)
  referralLogId String?      @map("referral_log_id")
  referralLog   ReferralLog? @relation(fields: [referralLogId], references: [id], onDelete: SetNull)

  rewardId String?            @map("reward_id")
  reward   UserDigitalReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("credit_transactions")
}

// ---
// User Digital Reward — 해금된 디지털 특전 기록
// 사용자가 충분한 크레딧을 적립해 디지털 특전을 해금했을 때의 기록
// ---
model UserDigitalReward {
  id String @id @default(cuid())

  userId String @map("user_id")
  user   User   @relation("DigitalRewards", fields: [userId], references: [id], onDelete: Cascade)

  rewardKey       String @map("reward_key") // "hologram_theme", "custom_domain", etc.
  rewardName      String @map("reward_name") // 한글 이름
  requiredCredits Int    @map("required_credits") // 해금에 필요했던 크레딧

  // 특전별 설정 (예: 커스텀 도메인인 경우)
  customValue String? @map("custom_value") // 도메인 선택값, etc.
  isActive    Boolean @default(true) @map("is_active")

  // 특전 크레딧 차감 기록
  creditTransactions CreditTransaction[]

  unlockedAt DateTime @default(now()) @map("unlocked_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, rewardKey])
  @@index([userId])
  @@index([rewardKey])
  @@map("user_digital_rewards")
}

// ---
// Referral Code — 추천 링크 통계
// 사용자의 추천 링크가 얼마나 많은 신규 가입을 유도했는지 추적
// ---
model ReferralCodeStats {
  id String @id @default(cuid())

  userId String @unique @map("user_id")
  user   User   @relation("ReferralCodeStats", fields: [userId], references: [id], onDelete: Cascade)

  referralCode String @unique @map("referral_code")

  // 통계
  totalReferrals        Int @default(0) @map("total_referrals") // 총 추천인 수
  successfulConversions Int @default(0) @map("successful_conversions") // 결제 완료인 수
  totalCreditsAwarded   Int @default(0) @map("total_credits_awarded") // 지급된 총 크레딧

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("referral_code_stats")
}

// ---
// Stripe Payment Record — 결제 이력 추적
// 중복 결제 방지 및 환불 처리를 위해 결제 기록 저장
// ---
model StripePaymentRecord {
  id String @id @default(cuid())

  userId    String @map("user_id")
  sessionId String @map("session_id")

  // 중복 결제 방지: 동일 카드의 Fingerprint 저장
  paymentMethodFingerprint String? @map("payment_method_fingerprint")

  // 결제 정보
  amount   Int    @map("amount") // 금액 (센트)
  currency String @default("usd") @map("currency")

  // 상태: COMPLETED, REFUNDED, CANCELED
  status String @default("COMPLETED") @map("status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([sessionId])
  @@map("stripe_payment_records")
}
