generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  binderCards   UserBinderCard[]
}

model Group {
  id        String     @id @default(cuid())
  name      String     @unique
  slug      String     @unique
  imageUrl  String?
  members   Member[]
  cards     PhotoCard[]
  createdAt DateTime   @default(now())
}

model Member {
  id        String     @id @default(cuid())
  name      String
  slug      String
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  cards     PhotoCard[]
  createdAt DateTime   @default(now())

  @@unique([groupId, slug])
}

model PhotoCard {
  id                String     @id @default(cuid())
  slug              String     @unique
  cardName          String
  imageUrl          String?
  thumbImagePath    String?
  estimatedPrice    Float
  haveCount         Int        @default(0)
  wantCount         Int        @default(0)
  viewCount         Int        @default(0)
  badge             String?
  isoNumber         String?
  pobCode           String?
  groupId           String
  memberId          String
  albumTitle        String?

  group             Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member            Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  priceHistory      PriceHistory[]
  skuMappings       GlobalSKUMapping[]
  userBinders       UserBinderCard[]

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([groupId])
  @@index([memberId])
}

model UserBinderCard {
  id          String     @id @default(cuid())
  userId      String
  cardId      String
  tag         String?    @default("In Hand")

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  card        PhotoCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@unique([userId, cardId])
}

model PriceHistory {
  id          String     @id @default(cuid())
  cardId      String
  price       Float
  currency    String     @default("USD")
  market      String     @default("ebay")
  sourceUrl   String?

  card        PhotoCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  createdAt   DateTime   @default(now())

  @@index([cardId])
  @@index([market])
}

model GlobalSKUMapping {
  id          String     @id @default(cuid())
  cardId      String
  market      String
  sku         String
  skuUrl      String?
  isActive    Boolean    @default(true)
  lastChecked DateTime   @default(now())

  card        PhotoCard  @relation(fields: [cardId], references: [id], onDelete: Cascade)

  updatedAt   DateTime   @updatedAt

  @@unique([cardId, market, sku])
  @@index([cardId])
  @@index([market])
}
